<%- include('../partials/header', { pageTitle: pageTitle }) %>

<section class="hero">
  <h1>Katalog Buku Perpustakaan</h1>
  <p>
    Katalog buku perpustakaan adalah daftar seluruh koleksi buku yang dimiliki perpustakaan,
    lengkap dengan judul, penulis, genre, tahun terbit, jumlah eksemplar, dan sinopsis singkat.
    Katalog membantu pengunjung dan petugas menemukan buku dengan cepat serta memantau
    ketersediaan koleksi.
  </p>
</section>

<section class="stats">
  <div class="stat">
    <span class="stat-num"><%= totalJudul %></span>
    <span class="stat-label">Judul ditampilkan</span>
  </div>
  <div class="stat">
    <span class="stat-num"><%= totalEksemplar %></span>
    <span class="stat-label">Total eksemplar</span>
  </div>
  <div class="stat">
    <span class="stat-num"><%= genreAktif || 'Semua' %></span>
    <span class="stat-label">Genre aktif</span>
  </div>
</section>

<div class="card">
  <form method="GET" action="/buku" class="filter">
    <input type="text" name="q" value="<%= q %>" placeholder="Cari judul atau penulis..." aria-label="Cari judul atau penulis">
    <select name="genre" aria-label="Filter berdasarkan genre">
      <option value="">Semua Genre</option>
      <% genreList.forEach(g => { %>
        <option value="<%= g %>" <%= g === genreAktif ? 'selected' : '' %>><%= g %></option>
      <% }) %>
    </select>
    <button type="submit" class="btn">Cari / Filter</button>
    <a href="/buku" class="link">Reset</a>
  </form>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Sampul</th>
          <th>Judul &amp; Penulis</th>
          <th>Genre</th>
          <th>Tahun</th>
          <th>Stok</th>
          <th>Harga Ganti</th>
          <th>Terdaftar</th>
          <th>Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (bukuList.length === 0) { %>
          <tr><td colspan="9" class="center empty">Tidak ada data buku yang cocok.</td></tr>
        <% } else { %>
          <% bukuList.forEach(b => { %>
            <tr>
              <td><%= b.id %></td>
              <td>
                <img class="cover"
                     src="<%= b.foto || '/img/placeholder.svg' %>"
                     alt="Sampul <%= b.judul %>"
                     loading="lazy"
                     onerror="this.onerror=null;this.src='/img/placeholder.svg';">
              </td>
              <td>
                <strong class="judul"><%= b.judul %></strong>
                <div class="muted"><%= b.penulis %></div>
                <% if (b.sinopsis) { %>
                  <div class="sinopsis"><%= b.sinopsis %></div>
                <% } %>
              </td>
              <td><span class="badge"><%= b.genre %></span></td>
              <td><%= b.tahun_terbit %></td>
              <td><%= b.jumlah_eksemplar %></td>
              <td>Rp <%= Number(b.harga_ganti).toLocaleString('id-ID') %></td>
              <td><%= new Date(b.tanggal_registrasi + 'T00:00:00').toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
              <td>
                <div class="aksi">
                  <a class="btn-edit" href="/buku/edit/<%= b.id %>">Edit</a>
                  <form action="/buku/hapus/<%= b.id %>" method="POST"
                        onsubmit="return confirm('Yakin ingin menghapus buku ini?');">
                    <button type="submit" class="btn-del">Hapus</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>

  <p class="note">
    <strong>Keterangan:</strong> Stok adalah jumlah eksemplar yang dimiliki perpustakaan.
    Harga ganti adalah biaya yang dikenakan bila buku hilang. Sampul diambil dari URL foto;
    bila kosong atau gagal dimuat, gambar pengganti akan ditampilkan.
  </p>
</div>

<%- include('../partials/footer') %>